# Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Dashboard -> Settings -> Webhooks -> create a webhook, copy its secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Your deployed frontend origin(s) for the CORS allowlist - comma-separated if you have more
# than one (e.g. a vercel.app domain plus a custom domain). Must be exact origins: scheme +
# host, no trailing slash or path. Use http://localhost:3000 for local dev.
FRONTEND_URL=https://thapasyabangles.vercel.app,https://www.thapasyabangles.com,https://thapasyabangles.com

# Firebase credentials: preferred way is a FILE, not an env var - see below.
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key,
# save the downloaded file as server/ServiceAccount.json (gitignored). Nothing to set here
# for that case - config.py finds it automatically.
#
# Only needed as a fallback on platforms where you can't commit/upload that file (e.g. Railway):
# paste the ENTIRE downloaded JSON file content as a single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "..."}
