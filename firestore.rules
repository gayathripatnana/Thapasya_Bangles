rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Storefront catalog & site content - anyone can read, only the admin account can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /category_pictures/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /intro_pictures/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /featured_products/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews - anyone can read; a signed-in customer may leave exactly one review per
    // product per delivered order (enforced by requiring the review doc id to be
    // `${orderId}_${productId}` - re-submitting that same id is an update, which only
    // admin can do, so it can't be edited/spammed by the customer after creation).
    // Verified-purchase check: the referenced order must belong to the requester, be
    // Delivered, and actually contain the product (via the order's `productIds` array).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.orderId is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && reviewId == request.resource.data.orderId + '_' + request.resource.data.productId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'Delivered'
        && request.resource.data.productId in get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productIds;
      allow update, delete: if isAdmin();
    }

    // Orders - checkout is online-payment-only, so every order is created exclusively by
    // the payment backend's Admin SDK (after verifying a real Razorpay signature), which
    // bypasses these rules entirely. No client can create, edit, or delete an order directly -
    // a customer can only read back their own, and only admin can update status or read all.
    match /orders/{orderId} {
      allow create, update, delete: if isAdmin();
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
    }

    // Written only by the payment backend's Firebase Admin SDK (which bypasses these rules
    // entirely) after verifying a Razorpay signature - no client should ever touch this directly
    match /pending_payments/{orderId} {
      allow read, write: if false;
    }

    // Per-user data - only the owning signed-in user (admin can additionally read profiles,
    // e.g. for the Customers admin page, but never write another user's profile)
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /carts/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /wishlists/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
